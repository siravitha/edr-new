{
  "name": "uth-smart-assets-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema ../prisma/schema.prisma && rm -rf node_modules/.prisma/client && cp -a ../node_modules/.prisma/client node_modules/.prisma/client",
    "prisma:migrate": "prisma migrate dev --schema ../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
