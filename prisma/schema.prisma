generator client {
  provider = "prisma-client-js"
  output   = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  REPAIR
  QUARANTINED
  DISPOSED
}

model Plan {
  id          String @id @default(uuid())
  hospitalId  String
  fiscalYear  Int
  title       String
  approved    Boolean @default(false)
  budget      Decimal
  orders      PurchaseOrder[]
  @@unique([hospitalId, id])
}

model PurchaseOrder {
  id          String @id @default(uuid())
  hospitalId  String
  planId      String
  number      String
  status      String @default("DRAFT")
  plan        Plan @relation(fields: [hospitalId, planId], references: [hospitalId, id])
  lines       POLine[]
  claims      PaymentClaim[]
  exceptions  WorkflowException[]
  @@unique([hospitalId, id])
  @@unique([hospitalId, number])
}

model POLine {
  id          String @id @default(uuid())
  hospitalId  String
  poId        String
  description String
  quantity    Int
  unitCost    Decimal
  po          PurchaseOrder @relation(fields: [hospitalId, poId], references: [hospitalId, id])
  receipts    ReceiptLine[]
  @@unique([hospitalId, id])
}

model ReceiptLine {
  id          String @id @default(uuid())
  hospitalId  String
  poLineId    String
  documentNo  String
  acceptedQty Int
  acceptedAt  DateTime
  acceptedBy  String
  poLine      POLine @relation(fields: [hospitalId, poLineId], references: [hospitalId, id])
  assets      Asset[]
  @@unique([hospitalId, id])
}

model Asset {
  id          String @id @default(uuid())
  hospitalId  String
  wardId      String
  receiptId   String
  assetNo     String
  name        String
  status      AssetStatus @default(AVAILABLE)
  version     Int @default(0)
  needsReview Boolean @default(false)
  cost        Decimal
  receipt     ReceiptLine @relation(fields: [hospitalId, receiptId], references: [hospitalId, id])
  conflicts   ConflictCase[]
  journals    JournalEntry[]
  @@unique([hospitalId, id])
  @@unique([hospitalId, assetNo])
  @@index([hospitalId, wardId, status])
}

model PaymentClaim {
  id          String @id @default(uuid())
  hospitalId  String
  poId        String
  claimNo     String
  revision    Int
  status      String @default("DRAFT")
  amount      Decimal
  reason      String?
  po          PurchaseOrder @relation(fields: [hospitalId, poId], references: [hospitalId, id])
  @@unique([hospitalId, claimNo, revision])
}

model JournalEntry {
  id          String @id @default(uuid())
  hospitalId  String
  assetId     String
  referenceNo String
  accountCode String
  debit       Decimal
  credit      Decimal
  postedAt    DateTime
  reversalOf  String?
  asset       Asset @relation(fields: [hospitalId, assetId], references: [hospitalId, id])
  @@index([hospitalId, assetId])
}

model WorkflowException {
  id           String @id @default(uuid())
  hospitalId   String
  poId         String
  type         String
  reason       String
  ownerSubject String
  status       String @default("OPEN")
  dueAt        DateTime?
  createdAt    DateTime @default(now())
  po           PurchaseOrder @relation(fields: [hospitalId, poId], references: [hospitalId, id])
  @@index([hospitalId, status, dueAt])
}

model AuditLog {
  id           String @id @default(uuid())
  hospitalId   String
  assetId      String
  actorSubject String
  providerRef  String?
  deviceId     String
  mutationId   String
  ip           String
  eventType    String
  detail       Json
  createdAt    DateTime @default(now())
  @@index([hospitalId, assetId, createdAt])
}

model SyncReceipt {
  id           String @id @default(uuid())
  hospitalId   String
  deviceId     String
  mutationId   String
  actorSubject String
  requestHash  String
  result       Json
  createdAt    DateTime @default(now())
  @@unique([hospitalId, deviceId, mutationId])
}

model ConflictCase {
  id              String @id @default(uuid())
  hospitalId      String
  assetId         String
  baseVersion     Int
  currentVersion  Int
  proposedStatus  AssetStatus
  deviceId        String
  mutationId      String
  status          String @default("OPEN")
  createdAt       DateTime @default(now())
  asset           Asset @relation(fields: [hospitalId, assetId], references: [hospitalId, id])
  @@index([hospitalId, assetId, status])
}
